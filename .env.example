# Assay — example environment. Copy to `.env` and fill in. NEVER commit `.env`.
# Consumed by docker-compose and by `assayd` (parsed once at startup via caarlos0/env).

# ── HTTP ────────────────────────────────────────────────────────────────────
ASSAY_HTTP_ADDR=:8080

# ── Database (Postgres only — the single source of truth) ────────────────────
# App connection string. In docker-compose this points at the `postgres` service.
ASSAY_DATABASE_URL=postgres://assay:assay@postgres:5432/assay?sslmode=disable
# Credentials the bundled postgres container is initialized with (compose only).
ASSAY_POSTGRES_USER=assay
ASSAY_POSTGRES_PASSWORD=assay
ASSAY_POSTGRES_DB=assay

# ── Secrets ──────────────────────────────────────────────────────────────────
# Guards all management endpoints (create/delete projects, apps, keys, scorers).
ASSAY_ADMIN_TOKEN=change-me-admin-token
# AES-256-GCM key for encrypting judge API keys + target-endpoint secrets at rest.
# Must be exactly 32 bytes, base64-encoded. Generate: `openssl rand -base64 32`
ASSAY_ENCRYPTION_KEY=change-me-base64-32-bytes

# ── Default judge LLM (OpenAI-compatible; global default) ─────────────────────
# Works with OpenAI, Azure OpenAI, OpenRouter, vLLM, and Ollama's /v1 endpoint.
# Overridable per-project and per-scorer via the API (those overrides are encrypted).
ASSAY_JUDGE_BASE_URL=https://api.openai.com/v1
ASSAY_JUDGE_API_KEY=sk-change-me
ASSAY_JUDGE_MODEL=gpt-4o-mini
# Local-model example (no cloud key needed):
# ASSAY_JUDGE_BASE_URL=http://host.docker.internal:11434/v1
# ASSAY_JUDGE_MODEL=llama3.1

# ── Worker / queue ────────────────────────────────────────────────────────────
ASSAY_WORKER_CONCURRENCY=            # blank = GOMAXPROCS
ASSAY_JOB_MAX_ATTEMPTS=3

# ── Data lifecycle ────────────────────────────────────────────────────────────
ASSAY_TRACE_RETENTION_DAYS=0         # 0 = keep forever; >0 = TTL cleanup job drops older partitions

# ── Behaviour ─────────────────────────────────────────────────────────────────
ASSAY_AUTO_CREATE_APPS=false         # auto-create an Application from an unknown trace's slug
ASSAY_UI_ENABLED=true                # serve the embedded React UI at /
ASSAY_LOG_FORMAT=json                # json | text

# ── Python client / CLI (developer machine) ──────────────────────────────────
# ASSAY_ENDPOINT=http://localhost:8080
# ASSAY_API_KEY=asy_...              # project-scoped key for tracing + data ops
