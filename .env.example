# Assay — example environment. Copy to a new `.env`, fill in, and never commit it.
# Source Compose uses docker-compose.yml. Published Compose additionally requires ASSAY_IMAGE.

# ── HTTP ────────────────────────────────────────────────────────────────────
ASSAY_HTTP_ADDR=:8080
ASSAY_HTTP_PORT=8080

# ── Database (Postgres only — the single source of truth) ────────────────────
# Docker Compose overrides ASSAY_DATABASE_URL with its internal Postgres address.
# Generate a fresh URL-safe password: openssl rand -hex 32
ASSAY_DATABASE_URL=
ASSAY_POSTGRES_USER=assay
ASSAY_POSTGRES_PASSWORD=
ASSAY_POSTGRES_DB=assay
ASSAY_POSTGRES_PORT=5432

# ── Secrets ──────────────────────────────────────────────────────────────────
# Required unless ASSAY_LOCAL_MODE=true. Generate separately: openssl rand -hex 32
ASSAY_ADMIN_TOKEN=
# AES-256-GCM key for judge API keys + target-endpoint secrets at rest.
# Must be exactly 32 bytes, base64-encoded. Generate once: openssl rand -base64 32
# Keep it with the database backup; changing it prevents decryption of stored secrets.
ASSAY_ENCRYPTION_KEY=

# ── Default judge LLM (optional for tracing; global default) ──────────────────
# Set all applicable values for an OpenAI-compatible judge. These may also be overridden
# per project/scorer through the API. Leave blank for tracing-only deployments.
ASSAY_JUDGE_BASE_URL=
ASSAY_JUDGE_API_KEY=
ASSAY_JUDGE_MODEL=
# Linux local judge example: http://host.docker.internal:11434/v1

# ── Worker / queue ────────────────────────────────────────────────────────────
ASSAY_WORKER_CONCURRENCY=            # blank = GOMAXPROCS
ASSAY_JOB_MAX_ATTEMPTS=3

# ── Data lifecycle ────────────────────────────────────────────────────────────
ASSAY_TRACE_RETENTION_DAYS=0         # 0 = keep forever; >0 = TTL cleanup job drops older partitions

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Opt-in admin-token bypass for a trusted local machine/Docker network only.
# Project ingest keys remain required. Never expose local mode publicly.
ASSAY_LOCAL_MODE=false
ASSAY_AUTO_CREATE_APPS=false         # auto-create an Application from an unknown trace's slug
ASSAY_UI_ENABLED=true                # local mode opens directly; token mode stores admin token
ASSAY_LOG_FORMAT=json                # json | text

# ── Published Compose only ────────────────────────────────────────────────────
# Verified server v0.1.0 digest; update deliberately after backup before upgrading.
# compose.published.yaml has no build; source Compose ignores this variable.
ASSAY_IMAGE=ghcr.io/marioweid/assay@sha256:ca095432a1cc199e33b5239959faa8b13364841c9c3cd4712c65a15410be297f

# ── Python client / CLI (developer machine) ──────────────────────────────────
# ASSAY_ENDPOINT=http://localhost:8080
# ASSAY_API_KEY=asy_...              # project-scoped key for tracing + data operations
# ASSAY_APPLICATION=your-app-slug    # existing application slug, not an ID or project name
# Demo chat only: generate privately with python -c "import secrets; print(secrets.token_hex(32))"
# ASSAY_CHAT_SIGNING_SECRET=          # persistent 64-char hex secret; never commit the value
# ASSAY_CHAT_SECURE_COOKIE=true       # set when the chat is served over HTTPS
# ASSAY_CHAT_ORIGIN=https://chat.example.org  # exact public origin for cross-site checks
